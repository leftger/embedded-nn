# embedded-nn TinyML HIL Agent & STMicroelectronics ST-LINK udev rules

# STM32WBA65 Live HIL Agent (pid.codes VID:1209 PID:e612)
SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="e612", MODE="0666", TAG+="uaccess"

# embedded-nn / GUI display agent (VID:1209 PID:e611)
SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="e611", MODE="0666", TAG+="uaccess"

